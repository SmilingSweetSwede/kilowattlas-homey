          "value": 10,
          "min": 0.5,
          "max": 1000,
          "units": {
            "en": "kWh"
          }
        },
        {
          "id": "max_kw",
          "type": "number",
          "label": {
            "en": "Max charge/discharge power (kW)"
          },
          "value": 5,
          "min": 0.1,
          "max": 500,
          "units": {
            "en": "kW"
          }
        }
      ],
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
