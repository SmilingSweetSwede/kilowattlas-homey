      "capabilitiesOptions": {
        "meter_power.charged": {
          "title": {
            "en": "Charged Energy"
          }
        },
        "meter_power.discharged": {
          "title": {
            "en": "Discharged Energy"
          }
        }
      },
      "energy": {
